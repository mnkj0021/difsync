NODE_ENV=production
DIFSYNC_HOST=127.0.0.1
DIFSYNC_PORT=8890
DIFSYNC_DB_FILE=./var/difsync.sqlite
DIFSYNC_APP_ORIGIN=https://difsync.com
DIFSYNC_ALLOW_REGISTRATION=true

# Generate 32 random bytes and encode as base64. Never commit the real key.
DIFSYNC_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Optional provider credentials. Keep them server-side only.
GOOGLE_HOME_CLIENT_ID=
GOOGLE_HOME_CLIENT_SECRET=
ALEXA_CLIENT_ID=
ALEXA_CLIENT_SECRET=
