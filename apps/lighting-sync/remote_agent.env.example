DIFSYNC_SYNC_CLOUD_URL=https://hub.your-domain.com
DIFSYNC_SYNC_CLOUD_URL_FALLBACK=https://www.hub.your-domain.com
DIFSYNC_SYNC_AGENT_ID=home-rgb-pc
DIFSYNC_SYNC_AGENT_NAME=Home RGB PC
DIFSYNC_SYNC_AGENT_TOKEN=replace-with-agent-token-from-config-php
DIFSYNC_SYNC_POLL_SECONDS=0.25

PC_RGB_BACKEND=native
PC_RGB_RAM_PROBE_SECONDS=30
PC_RGB_RAM_ALLOW_EXPERIMENTAL=false
PC_RGB_WINRING_DLL=.\OpenRGB\dependencies\winring0\x64\WinRing0x64.dll
PC_RGB_PAWNIO_DLL=.\_winget_dl\openrgb_extract\OpenRGB\PawnIOLib.dll
PC_RGB_PAWNIO_I801_BIN=.\_winget_dl\openrgb_extract\OpenRGB\SmbusI801.bin
PC_RGB_ASUS_ADDRESSABLE_LEDS=24
PC_RGB_ASUS_STATIC_FALLBACK=true
PC_RGB_ASUS_FORCE_STATIC_ALL_CHANNELS=true
PC_RGB_ASUS_REASSERT_DIRECT_AFTER_STATIC=true
PC_RGB_ASUS_WRITE_PASSES=2
PC_RGB_NZXT_FORCE_UNKNOWN_CHANNELS=true
PC_RGB_NZXT_UNKNOWN_LED_COUNT=18
# Optional per-header override, e.g. "24,24,16"
# PC_RGB_ASUS_ADDRESSABLE_LEDS_PER_HEADER=24,24
